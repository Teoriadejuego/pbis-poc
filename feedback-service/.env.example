# Copiar como .env sólo en el servidor privado. No incluir en las descargas.
RESEND_API_KEY=
FEEDBACK_FROM=
# Ruta ABSOLUTA fuera del directorio público, en disco persistente y privado.
FEEDBACK_DB=/var/lib/pbis-feedback/opiniones.sqlite
FEEDBACK_HOST=127.0.0.1
FEEDBACK_PORT=8787
FEEDBACK_DAILY_LIMIT=500
# Máximo de peticiones por IP de conexión/hora; tras un proxy todas comparten su IP.
FEEDBACK_CONNECTION_LIMIT=30
