{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catálogo de columnas del ejemplo preparado PBIS",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "centers", "courses", "groups", "dataColumns", "groupColumns", "keyColumns", "profileColumns", "scale"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+$"},
    "centers": {"$ref": "#/definitions/names"},
    "courses": {"$ref": "#/definitions/names"},
    "groups": {"$ref": "#/definitions/names"},
    "dataColumns": {"$ref": "#/definitions/names"},
    "groupColumns": {"$ref": "#/definitions/names"},
    "keyColumns": {"$ref": "#/definitions/names"},
    "profileColumns": {"$ref": "#/definitions/names"},
    "scale": {"const": "normalizada_v1"}
  },
  "definitions": {
    "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
